# mock = chạy offline không cần API key | openai = mọi API tương thích OpenAI | ollama = model local
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=3
RAG_MIN_SCORE=2.0

# --- Dùng Claude (Anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<khóa lấy ở console.anthropic.com>
# LLM_MODEL=claude-opus-5-5        # hoặc claude-sonnet-5-5 / claude-haiku-5-5
# LLM_EFFORT=medium                # low | medium | high

# --- Google Gemini (khóa tại aistudio.google.com) ---
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite                 # nhanh (2-5 giây), đủ tốt cho CSKH
# LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash   # thử lần lượt khi model chính lỗi/quá tải
# LLM_PRIMARY_TIMEOUT=10                          # chờ model chính tối đa N giây rồi chuyển dự phòng
# EMBEDDING_MODEL=gemini-embedding-001            # RAG tìm theo nghĩa (dùng chung base URL + khóa ở trên)

# --- Đăng nhập Admin (app/auth.py) ---
# ADMIN_AUTH=1                 # 0 = tắt kiểm tra token (chỉ để thử nội bộ)
# ADMIN_SESSION_HOURS=12
# Đổi mật khẩu: python -m app.auth set admin <mật khẩu mới>

# Giới hạn lượt gọi model cho mỗi khách mỗi ngày (link demo công khai); 0 = không giới hạn
MODEL_CALLS_PER_DAY=40
# Giá model (USD / 1 triệu token) để tính chi phí ở Observability -> Metrics.
# Bỏ trống thì dùng bảng giá có sẵn (Claude); model lạ (vd GPT qua proxy) dùng giá ước tính 0.15 / 0.60.
# LLM_PRICE_INPUT=0.15
# LLM_PRICE_OUTPUT=0.60
# Model giám khảo cho evals: python -m evals.run_evals --judge llm (mặc định = LLM_MODEL)
JUDGE_MODEL=
