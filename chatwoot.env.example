# Biến môi trường cho Chatwoot (dùng với docker-compose.chatwoot.yml). Đổi các giá trị bí mật trước khi chạy.
SECRET_KEY_BASE=replace_with_output_of_openssl_rand_hex_64
FRONTEND_URL=http://localhost:3000
DEFAULT_LOCALE=vi
ENABLE_ACCOUNT_SIGNUP=false

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot_local_pw
POSTGRES_DATABASE=chatwoot

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=chatwoot_redis_pw
